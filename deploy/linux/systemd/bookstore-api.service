[Unit]
Description=Bookstore API (ASP.NET Core on Kestrel)
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=notify
User=bookstore
Group=bookstore
WorkingDirectory=/opt/bookstore/current
ExecStart=/usr/bin/dotnet /opt/bookstore/current/Bookstore.Api.dll
Restart=always
RestartSec=10
TimeoutStopSec=30
MemoryHigh=384M
MemoryMax=512M
SyslogIdentifier=bookstore-api
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://127.0.0.1:5000
Environment=DOTNET_NOLOGO=true
EnvironmentFile=/etc/bookstore/secrets.env
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
CapabilityBoundingSet=
ReadWritePaths=/var/lib/bookstore

[Install]
WantedBy=multi-user.target
