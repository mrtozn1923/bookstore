# syntax=docker/dockerfile:1
FROM alpine:3
# Secret yalnız bu RUN adımında /run/secrets altında görünür, layer'a yazılmaz
RUN --mount=type=secret,id=nuget_token \
    printf 'feed=https://pkgs.example.com/bookstore\ntoken=%s\n' "$(cat /run/secrets/nuget_token)" > /tmp/feed.conf \
 && echo "restoring with $(wc -c < /tmp/feed.conf) bytes of config" && rm /tmp/feed.conf
