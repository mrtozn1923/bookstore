@model BookCardViewModel
@{
    // full class names: Tailwind only generates what it sees in the source
    string stockClasses = Model.InStock
        ? "bg-emerald-50 text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300"
        : "bg-slate-100 text-slate-500 dark:bg-slate-800 dark:text-slate-400";
}
<article class="flex flex-col gap-3 rounded-card border border-line bg-surface p-4 shadow-sm dark:shadow-none">
    <img class="aspect-2/3 w-full rounded-md object-cover" src="@Model.CoverUrl" alt="Cover of @Model.Title" width="120" height="180" loading="lazy">
    <div class="flex flex-wrap gap-2">
        <span class="category-badge rounded-full bg-(--cat-color)/15 px-2 py-0.5 text-xs font-medium text-(--cat-color)" style="--cat-color: @Model.Category.Color">@Model.Category.Name</span>
        <span class="stock-badge rounded-full px-2 py-0.5 text-xs font-medium @stockClasses">@(Model.InStock ? "In stock" : "Out of stock")</span>
    </div>
    <h3 class="font-display text-lg font-semibold underline-offset-4 hover:underline">@Model.Title</h3>
    <p class="text-sm text-fg-muted">@Model.Author</p>
    <div class="mt-auto flex items-center justify-between">
        <span class="text-lg font-bold">@Model.Price.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) TRY</span>
        <button class="rounded-md bg-brand-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-brand-700">Add to cart</button>
    </div>
</article>
