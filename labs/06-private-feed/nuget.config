<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="bookstore" value="http://feed.bookstore.test:8085/v3/index.json" allowInsecureConnections="true" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="bookstore">
      <package pattern="Bookstore.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
  <packageSourceCredentials>
    <bookstore>
      <add key="Username" value="bookstore-ci" />
      <add key="ClearTextPassword" value="%NUGET_TOKEN%" />
    </bookstore>
  </packageSourceCredentials>
</configuration>
