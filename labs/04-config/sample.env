# Bookstore.Api local settings
SHIPPING_DEFAULT_COUNTRY=NO
SHIPPING_NOTE=Free shipping # over 500 TRY
SHIPPING_TRACKING_URL=https://bookstore.example/track#latest
SHIPPING_DOUBLE="first line\nsecond line"
SHIPPING_SINGLE='first line\nsecond line'
SHIPPING_MULTILINE="line one
line two"
SHIPPING_SPACES = padded
export SHIPPING_EXPORTED=yes
SHIPPING_TEMPLATE=${SHIPPING_DEFAULT_COUNTRY}-express
SHIPPING_EMPTY=
