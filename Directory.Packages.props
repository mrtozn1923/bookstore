<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Transitive dependencies (EF Core under the Aspire package, for example) also get the versions below. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup Label="Aspire">
    <PackageVersion Include="Aspire.Hosting.Keycloak" Version="13.6.5-preview.1.26559.7" />
    <PackageVersion Include="Aspire.Keycloak.Authentication" Version="13.6.5-preview.1.26559.7" />
    <PackageVersion Include="Aspire.Hosting.RabbitMQ" Version="13.6.5" />
    <PackageVersion Include="Aspire.Hosting.Redis" Version="13.6.5" />
    <PackageVersion Include="Aspire.Hosting.SqlServer" Version="13.6.5" />
    <PackageVersion Include="Aspire.Microsoft.EntityFrameworkCore.SqlServer" Version="13.6.5" />
    <PackageVersion Include="Aspire.Hosting.JavaScript" Version="13.6.5" />
    <PackageVersion Include="Aspire.StackExchange.Redis" Version="13.6.5" />
    <PackageVersion Include="Aspire.StackExchange.Redis.OutputCaching" Version="13.6.5" />
  </ItemGroup>
  <ItemGroup Label="ServiceDefaults">
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery.Yarp" Version="10.11.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.21.0" />
    <!-- Only beta versions exist on NuGet -->
    <PackageVersion Include="OpenTelemetry.Instrumentation.GrpcNetClient" Version="1.21.0-beta.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.21.0" />
  </ItemGroup>
  <ItemGroup Label="gRPC">
    <PackageVersion Include="Google.Protobuf" Version="3.36.2" />
    <PackageVersion Include="Grpc.AspNetCore" Version="2.85.0" />
    <PackageVersion Include="Grpc.Core.Api" Version="2.85.0" />
    <PackageVersion Include="Grpc.Net.Client" Version="2.85.0" />
    <PackageVersion Include="Grpc.Net.ClientFactory" Version="2.85.0" />
    <PackageVersion Include="Grpc.Tools" Version="2.85.0" />
  </ItemGroup>
  <ItemGroup Label="Messaging">
    <PackageVersion Include="WolverineFx" Version="6.64.0" />
    <PackageVersion Include="WolverineFx.EntityFrameworkCore" Version="6.64.0" />
    <PackageVersion Include="WolverineFx.RabbitMQ" Version="6.64.0" />
    <PackageVersion Include="WolverineFx.RuntimeCompilation" Version="6.64.0" />
    <PackageVersion Include="WolverineFx.SqlServer" Version="6.64.0" />
  </ItemGroup>
  <ItemGroup Label="Notifications">
    <PackageVersion Include="MailKit" Version="5.0.0" />
  </ItemGroup>
  <ItemGroup Label="Gateway">
    <PackageVersion Include="Yarp.ReverseProxy" Version="2.3.0" />
  </ItemGroup>
  <ItemGroup Label="Security">
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.15" />
  </ItemGroup>
  <ItemGroup Label="Web API">
    <PackageVersion Include="Asp.Versioning.Http" Version="10.2.3" />
    <PackageVersion Include="Asp.Versioning.OpenApi" Version="10.2.3" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.15" />
  </ItemGroup>
  <ItemGroup Label="Data">
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.15" />
  </ItemGroup>
  <ItemGroup Label="Tests">
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.Testing" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>
</Project>
