# .NET build output
bin/
obj/

# Provider binaries and the module cache
.terraform/

# State and its backups: they live in a remote backend and may contain secrets
*.tfstate
*.tfstate.*

# Saved plans, their text output and crash logs
tfplan
*.tfplan
plan.txt
drift.txt
crash.log
crash.*.log

# TF_LOG_PATH output: provider debug lines contain secret values
terraform.log

# CLI configuration files may contain credentials
.terraformrc
terraform.rc
