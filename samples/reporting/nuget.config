<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- No <clear />: this file is merged with the nuget.config at the repo root. -->
    <!-- Redefined here to add a 72-hour minimum publish age (NuGet 8 / .NET SDK 11). -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" minPublishAgeHours="72" />
    <!-- The company feed is HTTPS; the local BaGetter container in this sample is HTTP. -->
    <add key="bookstore-internal" value="http://127.0.0.1:52404/v3/index.json" allowInsecureConnections="true" />
  </packageSources>
  <packageSourceCredentials>
    <bookstore-internal>
      <add key="Username" value="%BOOKSTORE_FEED_USER%" />
      <add key="ClearTextPassword" value="%BOOKSTORE_FEED_PASSWORD%" />
    </bookstore-internal>
  </packageSourceCredentials>
  <packageSourceMapping>
    <packageSource key="bookstore-internal">
      <package pattern="Bookstore.*" />
    </packageSource>
  </packageSourceMapping>
  <minPublishAgeExceptions />
</configuration>
