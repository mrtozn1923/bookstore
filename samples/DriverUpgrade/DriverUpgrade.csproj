<Project Sdk="Microsoft.NET.Sdk">

  <!-- 15 - the same code against driver 2.x and 3.x: dotnet run -p:MongoDriverVersion=3.14.0 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <MongoDriverVersion Condition="'$(MongoDriverVersion)' == ''">2.30.0</MongoDriverVersion>
    <DefineConstants Condition="$(MongoDriverVersion.StartsWith('2.'))">$(DefineConstants);DRIVER2</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MongoDB.Driver" Version="$(MongoDriverVersion)" />
  </ItemGroup>

</Project>
