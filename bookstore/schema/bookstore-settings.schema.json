{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bookstore.example/schema/bookstore-settings.schema.json",
  "title": "Bookstore.Api settings",
  "description": "The Bookstore-specific sections of appsettings*.json",
  "type": "object",
  "properties": {
    "Catalog": { "$ref": "#/$defs/catalog" },
    "Ordering": { "$ref": "#/$defs/ordering" },
    "Shipping": { "$ref": "#/$defs/shipping" }
  },
  "$defs": {
    "catalog": {
      "type": "object",
      "properties": {
        "PageSize": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 },
        "MaxPageSize": { "type": "integer", "minimum": 1, "maximum": 500 }
      },
      "additionalProperties": false
    },
    "ordering": {
      "type": "object",
      "properties": {
        "InstitutionalMinQuantity": { "type": "integer", "minimum": 1 },
        "InstitutionalDiscountRate": { "type": "number", "exclusiveMinimum": 0, "maximum": 0.5 }
      },
      "additionalProperties": false
    },
    "shipping": {
      "type": "object",
      "properties": {
        "DefaultCountry": { "type": "string", "pattern": "^[A-Z]{2}$", "description": "ISO 3166-1 alpha-2 country code" },
        "Cutoff": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
        "Express": { "type": "boolean" },
        "MaxWeightGrams": { "type": "integer", "minimum": 1 },
        "ApiVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
        "Carriers": {
          "type": "array",
          "items": { "enum": ["standard", "express"] },
          "uniqueItems": true
        },
        "SupportEmail": { "type": "string", "format": "email" }
      },
      "additionalProperties": false
    }
  }
}
