<Project Sdk="Microsoft.NET.Sdk">

  <!-- The back office of 2016: ASP.NET on .NET Framework 4.8, hosted by IIS.
       SDK-style project so that "msbuild -restore" works without packages.config. -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <!-- IIS loads assemblies from the site's bin folder -->
    <OutputPath>bin\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Configuration" />
    <Reference Include="System.Web" />
    <PackageReference Include="Microsoft.Configuration.ConfigurationBuilders.Environment" Version="3.0.0" />
  </ItemGroup>

</Project>
