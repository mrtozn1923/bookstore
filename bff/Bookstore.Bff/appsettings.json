{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Spa": {
    "Root": "../../dist"
  },
  "ReverseProxy": {
    "Routes": {
      "orders": {
        "ClusterId": "bookstore-api",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/orders/{**rest}" }
      },
      "api": {
        "ClusterId": "bookstore-api",
        "Match": { "Path": "/api/{**rest}" }
      }
    },
    "Clusters": {
      "bookstore-api": {
        "Destinations": {
          "api": { "Address": "http://localhost:5080/" }
        }
      }
    }
  }
}
