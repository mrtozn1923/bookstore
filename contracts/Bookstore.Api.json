  },
  "components": {
    "schemas": {
      "BookDto": {
        "required": [
          "id",
          "isbn",
          "title",
          "price",
          "stock"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "isbn": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "price": {
            "type": "number",
            "format": "double"
          },
          "stock": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "BulkOrderLine": {
        "required": [
          "isbn",
          "quantity"
        ],
        "type": "object",
        "properties": {
          "isbn": {
            "type": "string"
          },
          "quantity": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "CouponDto": {
        "required": [
          "code",
          "percentOff",
          "validUntil"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "percentOff": {
            "type": "integer",
            "format": "int32"
          },
          "validUntil": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CreateBookRequest": {
        "required": [
          "isbn",
          "title",
          "price",
          "stock"
        ],
        "type": "object",
        "properties": {
          "isbn": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "price": {
            "type": "number",
            "format": "double"
          },
          "stock": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "CreateCouponRequest": {
        "required": [
          "code",
          "percentOff",
          "validUntil"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "percentOff": {
            "type": "integer",
            "format": "int32"
          },
          "validUntil": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "OrderDto": {
        "required": [
          "id",
          "reference",
          "status",
          "total",
          "trackingNumber",
          "createdAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "reference": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/OrderStatus"
          },
          "total": {
            "type": "number",
            "format": "double"
          },
          "trackingNumber": {
            "type": [
              "null",
              "string"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "OrderLineRequest": {
        "required": [
          "bookId",
          "quantity"
        ],
        "type": "object",
        "properties": {
          "bookId": {
            "type": "integer",
            "format": "int32"
          },
          "quantity": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "OrderStatus": {
        "enum": [
          "Placed",
          "Cancelled"
        ]
      },
      "PlaceBulkOrderRequest": {
        "required": [
          "lines"
        ],
        "type": "object",
        "properties": {
          "lines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BulkOrderLine"
            }
          }
        }
      },
      "PlaceOrderRequest": {
        "required": [
          "items",
          "shippingCity"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderLineRequest"
            }
          },
          "shippingCity": {
            "type": "string"
          },
          "couponCode": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Institutional"
    },
    {
      "name": "Orders"
    },
    {
      "name": "Books"
    },
    {
      "name": "Coupons"
    }
  ]
}