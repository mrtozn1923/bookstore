{
  "name": "bookstore-api",
  "version": "0.1.0",
  "private": true,
  "description": "Bookstore API on Node.js",
  "type": "module",
  "main": "src/server.js",
  "imports": {
    "#routes/*": "./src/routes/*.js",
    "#services/*": "./src/services/*.js",
    "#db/*": "./src/db/*"
  },
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": "^26.13.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "versions": "node -p process.versions.node"
  },
  "dependencies": {
    "@bookstore/contracts": "^0.1.0"
  }
}
