{
  "name": "bookstore-api",
  "version": "0.1.0",
  "private": true,
  "description": "Bookstore API on Node.js",
  "type": "module",
  "main": "src/server.ts",
  "imports": {
    "#http/*": "./src/http/*.ts",
    "#middleware/*": "./src/middleware/*.ts",
    "#routes/*": "./src/routes/*.ts",
    "#services/*": "./src/services/*.ts",
    "#domain/*": "./src/domain/*.ts",
    "#storage/*": "./src/storage/*.ts",
    "#db/*": "./src/db/*"
  },
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": "^26.13.0"
  },
  "scripts": {
    "start": "node src/server.ts",
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc",
    "versions": "node -p process.versions.node"
  },
  "dependencies": {
    "@bookstore/contracts": "^0.1.0",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
