{
  "name": "bookstore-api",
  "version": "0.1.0",
  "private": true,
  "description": "Bookstore API on Node.js",
  "type": "module",
  "main": "src/server.ts",
  "imports": {
    "#http/*": "./src/http/*.ts",
    "#middleware/*": "./src/middleware/*.ts",
    "#routes/*": "./src/routes/*.ts",
    "#handlers/*": "./src/handlers/*.ts",
    "#schemas/*": "./src/schemas/*.ts",
    "#services/*": "./src/services/*.ts",
    "#repositories/*": "./src/repositories/*.ts",
    "#domain/*": "./src/domain/*.ts",
    "#storage/*": "./src/storage/*.ts",
    "#db/*": "./src/db/*"
  },
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": "^26.13.0"
  },
  "scripts": {
    "start": "node src/server.ts",
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc",
    "versions": "node -p process.versions.node",
    "db:setup": "node --env-file-if-exists=.env scripts/db-setup.ts",
    "db:load": "node --env-file-if-exists=.env scripts/load-catalog.ts",
    "dev:issuer": "node scripts/dev-issuer.ts"
  },
  "dependencies": {
    "@bookstore/contracts": "^0.1.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jose": "^6.2.17",
    "mssql": "^12.7.14",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/mssql": "^12.3.0",
    "@types/node": "^26.6.6",
    "pino-pretty": "^13.2.0",
    "typescript": "^7.0.2"
  }
}
