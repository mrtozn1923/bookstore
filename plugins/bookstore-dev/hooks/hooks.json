{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PLUGIN_ROOT\\scripts\\protect-migrations.ps1\"",
            "onFailure": "block",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PLUGIN_ROOT\\scripts\\format-file.ps1\"",
            "timeout": 60,
            "statusMessage": "Formatting the changed file"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(dotnet test *)",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PLUGIN_ROOT\\scripts\\short-test-output.ps1\""
          },
          {
            "type": "command",
            "if": "PowerShell(dotnet test *)",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PLUGIN_ROOT\\scripts\\short-test-output.ps1\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PLUGIN_ROOT\\scripts\\stop-guard.ps1\"",
            "timeout": 600,
            "statusMessage": "Checking migrations and API tests"
          }
        ]
      }
    ]
  }
}
