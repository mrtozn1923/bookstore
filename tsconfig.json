{
  // Every example file is checked on its own (moduleDetection: force), as in the posts.
  // `npx tsc --noEmit` prints the compiler errors the posts show on purpose ("// Error:" lines).
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "strict": true,
    "noEmit": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "types": []
  },
  // O11 is its own small project (the post's recommended Node tsconfig): check it with `npx tsc -p O11`.
  // O13/erasable-syntax-only turns on erasableSyntaxOnly: `npx tsc -p O13/erasable-syntax-only`.
  "exclude": ["node_modules", "O11", "O13/erasable-syntax-only"]
}
