    "mini-css-extract-plugin": "^2.10.2",
    "rolldown": "~1.2.19",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.3.1",
    "webpack-dev-server": "^6.1.0"
