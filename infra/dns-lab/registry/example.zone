$TTL 86400
@               IN SOA  ns1.nic.example. hostmaster.nic.example. (
                        2026111405 ; serial
                        1800       ; refresh
                        900        ; retry
                        604800     ; expire
                        86400 )    ; negative caching TTL
@               IN NS   ns1.nic.example.
ns1.nic         IN A    192.0.2.10

dnshost         IN NS   ns1.dnshost.example.
ns1.dnshost     IN A    192.0.2.20

bookstore       IN NS   ns1.dnshost.example.
