<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Bookstore.Templates</PackageId>
    <PackageVersion>1.1.0</PackageVersion>
    <Title>Bookstore templates</Title>
    <Authors>Bookstore team</Authors>
    <Description>dotnet new templates for Bookstore services.</Description>
    <PackageTags>dotnet-new;templates;bookstore</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <PackageType>Template</PackageType>
    <TargetFramework>net10.0</TargetFramework>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <NoDefaultExcludes>true</NoDefaultExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="bookstore-service\**\*" Exclude="**\bin\**;**\obj\**" />
    <None Include="README.md" Pack="true" PackagePath="\" />
    <Compile Remove="**\*" />
  </ItemGroup>

</Project>
