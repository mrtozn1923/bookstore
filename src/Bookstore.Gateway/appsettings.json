{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "books": {
        "ClusterId": "catalog",
        "Match": { "Path": "/api/books/{**rest}" }
      },
      "orders": {
        "ClusterId": "ordering",
        "Match": { "Path": "/api/orders/{**rest}" }
      }
    },
    "Clusters": {
      "catalog": {
        "Destinations": {
          "catalog": { "Address": "https+http://catalog" }
        }
      },
      "ordering": {
        "Destinations": {
          "ordering": { "Address": "https+http://ordering" }
        }
      }
    }
  }
}
