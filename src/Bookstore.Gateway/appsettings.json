{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "GatewayConfig": ""
  },
  "ReverseProxy": {
    "Routes": {
      "catalog-v1": {
        "ClusterId": "catalog",
        "Match": {
          "Path": "/api/v1/books/{**rest}"
        },
        "Transforms": [
          { "PathPattern": "/books/{**rest}" }
        ]
      },
      "catalog-v1-mobile": {
        "ClusterId": "catalog",
        "Match": {
          "Path": "/api/v1/books",
          "Methods": [ "GET" ],
          "Headers": [
            {
              "Name": "X-Client-Platform",
              "Values": [ "mobile" ],
              "Mode": "ExactHeader"
            }
          ]
        },
        "Transforms": [
          { "PathSet": "/books/summary" }
        ]
      },
      "catalog-legacy": {
        "ClusterId": "catalog",
        "Match": {
          "Path": "/api/catalog/{**rest}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/catalog" }
        ]
      },
      "orders-v1": {
        "ClusterId": "ordering",
        "Match": {
          "Path": "/api/v1/orders/{**rest}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/v1" }
        ]
      },
      "orders-legacy": {
        "ClusterId": "ordering",
        "Match": {
          "Path": "/api/orders/{**rest}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api" }
        ]
      }
    },
    "Clusters": {
      "catalog": {
        "Destinations": {
          "catalog-1": { "Address": "http://localhost:5301/" }
        }
      },
      "ordering": {
        "Destinations": {
          "ordering-1": { "Address": "http://localhost:5302/" }
        }
      }
    }
  }
}
