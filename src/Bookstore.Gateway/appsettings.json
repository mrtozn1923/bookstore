{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "GatewayConfig": ""
  },
  "Gateway": {
    "Zone": "zone-a"
  },
  "Services": {
    "ordering": {
      "http": [
        "localhost:5302"
      ]
    }
  },
  "ReverseProxy": {
    "Routes": {
      "catalog-v1": {
        "ClusterId": "catalog",
        "Match": {
          "Path": "/api/v1/books/{**rest}"
        },
        "Transforms": [
          {
            "PathPattern": "/books/{**rest}"
          }
        ]
      },
      "catalog-v1-mobile": {
        "ClusterId": "catalog",
        "Match": {
          "Path": "/api/v1/books",
          "Methods": [
            "GET"
          ],
          "Headers": [
            {
              "Name": "X-Client-Platform",
              "Values": [
                "mobile"
              ],
              "Mode": "ExactHeader"
            }
          ]
        },
        "Transforms": [
          {
            "PathSet": "/books/summary"
          }
        ]
      },
      "catalog-legacy": {
        "ClusterId": "catalog",
        "Match": {
          "Path": "/api/catalog/{**rest}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/catalog"
          }
        ]
      },
      "orders-v1": {
        "ClusterId": "ordering",
        "Match": {
          "Path": "/api/v1/orders/{**rest}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/v1"
          }
        ]
      },
      "orders-legacy": {
        "ClusterId": "ordering",
        "Match": {
          "Path": "/api/orders/{**rest}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          }
        ]
      }
    },
    "Clusters": {
      "catalog": {
        "LoadBalancingPolicy": "PreferSameZone",
        "HealthCheck": {
          "AvailableDestinationsPolicy": "HealthyOrPanic",
          "Active": {
            "Enabled": true,
            "Interval": "00:00:05",
            "Timeout": "00:00:02",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          },
          "Passive": {
            "Enabled": true,
            "Policy": "TransportFailureRate",
            "ReactivationPeriod": "00:01:00"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "Metadata": {
          "ConsecutiveFailuresHealthPolicy.Threshold": "2",
          "TransportFailureRateHealthPolicy.RateLimit": "0.5"
        },
        "Destinations": {
          "catalog-1": {
            "Address": "http://localhost:5301/",
            "Metadata": {
              "Zone": "zone-a"
            }
          },
          "catalog-2": {
            "Address": "http://localhost:5311/",
            "Metadata": {
              "Zone": "zone-a"
            }
          },
          "catalog-3": {
            "Address": "http://localhost:5312/",
            "Metadata": {
              "Zone": "zone-b"
            }
          }
        }
      },
      "ordering": {
        "Destinations": {
          "ordering": {
            "Address": "http://ordering"
          }
        }
      }
    }
  }
}