{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "catalog": {
        "ClusterId": "catalog",
        "Match": {
          "Path": "/api/catalog/{**rest}"
        }
      },
      "orders": {
        "ClusterId": "ordering",
        "Match": {
          "Path": "/api/orders/{**rest}"
        }
      }
    },
    "Clusters": {
      "catalog": {
        "Destinations": {
          "catalog-1": { "Address": "http://localhost:5301/" }
        }
      },
      "ordering": {
        "Destinations": {
          "ordering-1": { "Address": "http://localhost:5302/" }
        }
      }
    }
  }
}
