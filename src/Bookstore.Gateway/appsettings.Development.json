{
  "Auth": {
    "SigningKey": "dev-only-bookstore-signing-key-not-a-secret-0123456789"
  },
  "ReverseProxy": {
    "Routes": {
      "catalog-debug": {
        "ClusterId": "catalog",
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/debug/catalog"
        },
        "Transforms": [
          {
            "PathSet": "/debug/request"
          },
          {
            "RequestHeaderOriginalHost": "true"
          }
        ]
      }
    }
  }
}