{
  "ReverseProxy": {
    "Routes": {
      "catalog-debug": {
        "ClusterId": "catalog",
        "Match": {
          "Path": "/debug/catalog"
        },
        "Transforms": [
          { "PathSet": "/debug/request" },
          { "RequestHeaderOriginalHost": "true" }
        ]
      }
    }
  }
}
