<Project Sdk="Microsoft.NET.Sdk.Razor">

  <ItemGroup>
    <PackageReference Include="ClosedXML" />
    <PackageReference Include="DocumentFormat.OpenXml" />
    <PackageReference Include="MailKit" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Localization" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
    <PackageReference Include="Microsoft.Playwright" />
    <PackageReference Include="PdfPig" />
    <PackageReference Include="PreMailer.Net" />
    <PackageReference Include="QuestPDF" />
    <PackageReference Include="SkiaSharp" />
    <!-- SkiaSharp ships Windows and macOS binaries only; Linux containers need this package -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Documents\Pdf\logo.png" LogicalName="Bookstore.Notifications.logo.png" />
    <EmbeddedResource Include="Documents\Html\quote.css" LogicalName="Bookstore.Notifications.quote.css" />
    <!-- Lato (SIL Open Font License 1.1, see fonts/OFL.txt), taken from the QuestPDF package -->
    <EmbeddedResource Include="Documents\Html\fonts\*.ttf" LogicalName="Bookstore.Notifications.fonts.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
