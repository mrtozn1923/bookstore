@* Shared layout: the <style> block is moved into style attributes by PreMailer after rendering *@
<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8">
    <title>@Title</title>
    <style>
        body { margin: 0; padding: 0; background-color: #f1f5f9; font-family: Arial, Helvetica, sans-serif; color: #0f172a; }
        .container { width: 600px; margin: 0 auto; background-color: #ffffff; }
        .header { background-color: #0f172a; color: #ffffff; padding: 16px 24px; font-size: 20px; font-weight: bold; }
        .content { padding: 24px; font-size: 15px; line-height: 22px; }
        .items { width: 100%; border-collapse: collapse; }
        .items th { text-align: left; border-bottom: 2px solid #cbd5e1; padding: 6px 4px; }
        .items td { border-bottom: 1px solid #e2e8f0; padding: 6px 4px; }
        .items .amount { text-align: right; white-space: nowrap; }
        .button { background-color: #0284c7; color: #ffffff; padding: 10px 18px; text-decoration: none; display: inline-block; }
        .footer { padding: 16px 24px; font-size: 12px; color: #64748b; }
    </style>
</head>
<body>
    <table class="container" role="presentation">
        <tr><td class="header">Bookstore</td></tr>
        <tr><td class="content">@ChildContent</td></tr>
        <tr><td class="footer">@Footer</td></tr>
    </table>
</body>
</html>

@code {
    [Parameter, EditorRequired] public required string Title { get; set; }
    [Parameter, EditorRequired] public required RenderFragment ChildContent { get; set; }
    [Parameter, EditorRequired] public required string Footer { get; set; }
}
