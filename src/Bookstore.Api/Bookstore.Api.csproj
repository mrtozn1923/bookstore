<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup Label="Container">
    <ContainerRepository>dockerseries-bookstore-api</ContainerRepository>
    <ContainerImageTags>1.0.0-sdk</ContainerImageTags>
    <ContainerFamily>noble-chiseled-extra</ContainerFamily>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <!-- Development settings stay on the developer machine, never in the image -->
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
