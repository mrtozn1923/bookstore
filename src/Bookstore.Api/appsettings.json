{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.AspNetCore.Authentication": "Information"
    }
  },
  "Urls": "https://localhost:7443",
  "Pki": {
    "TrustAnchors": "../../certs/root-ca.crt.pem",
    "Intermediates": "../../certs/services-ca.crt.pem"
  },
  "Kestrel": {
    "Certificates": {
      "Default": {
        "Path": "../../certs/api.crt.pem",
        "KeyPath": "../../certs/api.key.pem"
      }
    }
  }
}
