{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Bookstore": "Server=localhost,1433;Database=BookstoreDb;Integrated Security=true;TrustServerCertificate=true"
  },
  "Auth": {
    "Authority": "https://login.bookstore.example/"
  },
  "Payments": {
    "BaseUrl": "https://api.payments.example/",
    "ApiKey": "",
    "Resilience": {
      "Retry": {
        "MaxRetryAttempts": 3,
        "Delay": "00:00:02"
      },
      "AttemptTimeout": {
        "Timeout": "00:00:10"
      },
      "TotalRequestTimeout": {
        "Timeout": "00:00:30"
      }
    }
  },
  "Shipping": {
    "BaseUrl": "https://api.shipping.example/"
  },
  "Smtp": {
    "Host": "localhost",
    "Port": 25,
    "From": "orders@bookstore.example"
  }
}