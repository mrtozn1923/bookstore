{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Payments": {
    "Provider": {
      "BaseUrl": "http://localhost:9091/",
      "ApiKey": "fake-api-key-for-tests",
      "Webhooks": {
        "Secrets": [
          "test+webhook+secret+not+real"
        ],
        "Tolerance": "00:05:00"
      }
    },
    "Reconciliation": {
      "Interval": "00:01:00",
      "MinAge": "00:02:00",
      "AbandonAfter": "00:30:00"
    }
  },
  "Shipping": {
    "LegacyCarrier": {
      "BaseUrl": "http://localhost:9092/",
      "ClientId": "bookstore",
      "ClientSecret": "fake-client-secret-0000"
    }
  },
  "Invoicing": {
    "EInvoice": {
      "Endpoint": "https://127.0.0.1:52411/secure/EInvoiceService.svc",
      "Security": "UserName",
      "UserName": "bookstore-test",
      "Password": "example-password-change-me",
      "TrustedServerCertificatePath": "../Bookstore.FakeEInvoice/.local/fake-einvoice.cer",
      "SendTimeout": "00:00:02",
      "SenderTaxNumber": "9990000001",
      "LogMessages": true
    }
  },
  "FileDrops": {
    "WorkFolder": "../../.local/file-drops",
    "Supplier": {
      "Host": "127.0.0.1",
      "Port": 52422,
      "UserName": "supplier",
      "PrivateKeyPath": "../../.local/sftp/bookstore_supplier",
      "HostKeyFingerprint": "SHA256:set-this-to-your-test-host-key"
    },
    "Bank": {
      "Host": "127.0.0.1",
      "Port": 52421,
      "UserName": "bookstore-test",
      "Password": "example-password-change-me",
      "UseTls": true,
      "TrustedCertificatePath": "../../.local/bank-ftp/cert.pem"
    },
    "Polling": {
      "Enabled": false,
      "Interval": "00:05:00"
    }
  },
  "ExchangeRates": {
    "Endpoints": [
      "http://localhost:9093/",
      "http://localhost:9094/"
    ]
  },
  "Resilience": {
    "PaymentProvider": {
      "Retry": {
        "Delay": "00:00:01"
      },
      "AttemptTimeout": {
        "Timeout": "00:00:03"
      },
      "TotalRequestTimeout": {
        "Timeout": "00:00:10"
      }
    },
    "ExchangeRates": {
      "Hedging": {
        "Delay": "00:00:00.300",
        "MaxHedgedAttempts": 1
      },
      "TotalRequestTimeout": {
        "Timeout": "00:00:03"
      },
      "Endpoint": {
        "Timeout": {
          "Timeout": "00:00:01.500"
        }
      }
    }
  },
  "Notifications": {
    "Smtp": {
      "Host": "localhost",
      "Port": 2525,
      "From": "orders@bookstore.example.com"
    }
  },
  "Chaos": {
    "LegacyCarrier": {
      "Enabled": false,
      "FaultRate": 0.0,
      "LatencyRate": 0.0,
      "Latency": "00:00:03"
    }
  },
  "Telemetry": {
    "ConsoleExporter": false
  }
}
