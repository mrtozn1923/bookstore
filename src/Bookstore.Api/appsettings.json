{
  "ConnectionStrings": {
    "Bookstore": "Data Source=bookstore.db",
    "Redis": "localhost:6390"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "Bookstore.Api",
    "Audience": "Bookstore.Clients",
    "AccessTokenMinutes": 15
  },
  "Catalog": {
    "Name": "Bookstore Catalog",
    "PageSize": 20,
    "Currency": "TRY",
    "SupportEmail": "support@example.com"
  }
}
