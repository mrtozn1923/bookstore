<Project Sdk="Microsoft.NET.Sdk">

  <!-- PostgreSQL migrations for BookstoreContext (Database:Provider=Postgres) and a small migrator that applies them.
       SQL Server migrations stay in Bookstore.Api. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Bookstore.Migrations.Postgres</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bookstore.Api\Bookstore.Api.csproj" />
  </ItemGroup>

</Project>
