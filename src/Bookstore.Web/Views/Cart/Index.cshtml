@model IReadOnlyList<Bookstore.Web.Ordering.CartItemView>
@{
    ViewData["Title"] = "Cart";
}
<h1>Cart</h1>
@if (Model.Count == 0)
{
    <p>Your cart is empty.</p>
}
else
{
    <ul class="cart">
        @foreach (Bookstore.Web.Ordering.CartItemView item in Model)
        {
            <li>@item.Quantity × @item.Book.Title · @item.Total.ToString("0.00") TRY</li>
        }
    </ul>
    <p class="price">Total @Model.Sum(i => i.Total).ToString("0.00") TRY</p>
}
