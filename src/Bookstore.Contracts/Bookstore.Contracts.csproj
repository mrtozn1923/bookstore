<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Bookstore.Contracts</RootNamespace>
    <!-- The contracts package has its own version line, separate from the application. -->
    <VersionPrefix>1.0.0</VersionPrefix>
    <PackageId>Bookstore.Contracts</PackageId>
    <Authors>Bookstore platform team</Authors>
    <Description>Integration event contracts shared by Bookstore services.</Description>
    <PackageTags>bookstore;contracts;events</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
