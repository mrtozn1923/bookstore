{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "catalog": {
        "ClusterId": "catalog",
        "Match": { "Path": "/api/catalog/{**rest}" },
        "Transforms": [ { "PathPattern": "/api/v1/{**rest}" } ]
      },
      "orders-read": {
        "ClusterId": "ordering",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/orders/{**rest}", "Methods": [ "GET" ] },
        "Transforms": [ { "PathPattern": "/api/v1/orders/{**rest}" } ]
      },
      "orders-place": {
        "ClusterId": "ordering",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/orders", "Methods": [ "POST" ] },
        "RateLimiterPolicy": "place-order",
        "Transforms": [ { "PathPattern": "/api/v1/orders" } ]
      },
      "order-status-hub": {
        "ClusterId": "notifications",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/hubs/orders/{**rest}" }
      }
    },
    "Clusters": {
      "catalog": {
        "HttpRequest": { "ActivityTimeout": "00:00:05" },
        "Destinations": { "catalog": { "Address": "https+http://catalog" } }
      },
      "ordering": {
        "HttpRequest": { "ActivityTimeout": "00:00:10" },
        "Destinations": { "ordering": { "Address": "https+http://ordering" } }
      },
      "notifications": {
        "Destinations": { "notifications": { "Address": "https+http://notifications" } }
      }
    }
  }
}
