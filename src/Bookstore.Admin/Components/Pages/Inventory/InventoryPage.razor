@page "/inventory"
@rendermode InteractiveServer
@implements IDisposable
@inject BookstoreApiClient Api
@inject ILogger<InventoryPage> Logger

<PageTitle>Inventory</PageTitle>

<h1>Inventory</h1>

<p>
    <label>Low-stock threshold
        <input type="number" class="form-control form-control-sm d-inline w-auto"
               @bind:get="Filter!.Threshold" @bind:set="SetThreshold" @bind:event="oninput" />
    </label>
    <label class="ms-3">
        <input type="checkbox" @bind="Filter!.OnlyLow" @bind:after="LoadAsync" /> Only low stock
    </label>
</p>

@if (Stock is null)
{
    <p>Loading...</p>
}
else
{
    <BookList Items="Stock" LowStockThreshold="Filter!.Threshold" OnRestock="RestockAsync" />
    <p class="text-muted">Refreshed at @RefreshedAt.ToString("HH:mm:ss") UTC</p>
}

@code {
    private System.Timers.Timer? timer;

    // Filled during prerendering and handed to the interactive instance; reloaded after a circuit resumes.
    [PersistentState(RestoreBehavior = RestoreBehavior.SkipLastSnapshot)]
    public List<StockView>? Stock { get; set; }

    [PersistentState(RestoreBehavior = RestoreBehavior.SkipLastSnapshot)]
    public DateTime RefreshedAt { get; set; }

    // What the user chose; survives a circuit pause and resume.
    [PersistentState]
    public InventoryFilter? Filter { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Filter ??= new();
        Logger.LogInformation("OnInitializedAsync (renderer: {Renderer}, interactive: {Interactive}, restored: {Restored})",
            RendererInfo.Name, RendererInfo.IsInteractive, Stock is not null);
        if (Stock is null)
        {
            await LoadAsync();
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        Logger.LogInformation("OnAfterRender(firstRender: true): starting the refresh timer");
        timer = new System.Timers.Timer(TimeSpan.FromSeconds(30));
        timer.Elapsed += OnTimerElapsed;
        timer.Start();
    }

    private async Task LoadAsync()
    {
        IReadOnlyList<StockView> all = await Api.GetStockAsync();
        Stock = [.. Filter!.OnlyLow ? all.Where(s => s.Available <= Filter.Threshold) : all];
        RefreshedAt = DateTime.UtcNow;
    }

    private void SetThreshold(int value) => Filter!.Threshold = Math.Clamp(value, 0, 50);

    private async Task RestockAsync(RestockRequest request)
    {
        StockView current = Stock!.Single(s => s.Isbn == request.Isbn);
        await Api.SetQuantityOnHandAsync(request.Isbn, current.OnHand + request.Amount);
        await LoadAsync();
        Logger.LogInformation("Restocked {Isbn} by {Amount}", request.Isbn, request.Amount);
    }

    // Runs on a thread-pool thread, outside Blazor's event handling: switch to the renderer with InvokeAsync.
    private void OnTimerElapsed(object? sender, System.Timers.ElapsedEventArgs e) =>
        _ = InvokeAsync(async () =>
        {
            await LoadAsync();
            StateHasChanged();
            Logger.LogInformation("Timer refresh rendered");
        });

    public void Dispose()
    {
        Logger.LogInformation("Dispose: stopping the refresh timer");
        timer?.Dispose();
    }
}
