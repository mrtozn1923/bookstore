@page "/"
@inject BookstoreApiClient Api

<PageTitle>Dashboard</PageTitle>

<h1>Bookstore Admin</h1>

<p>The catalog has <strong>@totalBooks</strong> books.</p>

@code {
    private int totalBooks;

    protected override async Task OnInitializedAsync()
    {
        PagedResult<BookSummary> firstPage = await Api.GetBooksAsync(search: null, category: null, page: 1, pageSize: 1);
        totalBooks = firstPage.Total;
    }
}
