@page "/authors"
@rendermode InteractiveServer
@inherits OwningComponentBase<BookstoreContext>
@using Bookstore.Data
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore

<PageTitle>Authors</PageTitle>

<h1>Authors</h1>
<AuthorizeView Policy="@PanelPolicies.ManageCatalog">
    <p><a href="authors/new" class="btn btn-sm btn-primary">New author</a></p>
</AuthorizeView>

@if (Authors is null)
{
    <p>Loading...</p>
}
else
{
    <QuickGrid Items="Authors.AsQueryable()" Pagination="pagination" class="table table-sm">
        <PropertyColumn Property="a => a.Name" Sortable="true" IsDefaultSortColumn="true" />
        <PropertyColumn Property="a => a.BookCount" Title="Books" Sortable="true" Align="Align.End" />
    </QuickGrid>
    <Paginator State="pagination" />
}

@code {
    private readonly PaginationState pagination = new() { ItemsPerPage = 5 };

    // Loaded once during prerendering (see post 06); sorting and paging then happen in memory on the circuit.
    [PersistentState]
    public List<AuthorView>? Authors { get; set; }

    // Service is a BookstoreContext from a DI scope that belongs to this component and is disposed with it.
    protected override async Task OnInitializedAsync() =>
        Authors ??= await Service.Authors
            .OrderBy(a => a.Name)
            .Select(a => new AuthorView(a.Id, a.Name, a.Books.Count))
            .ToListAsync();
}
