<td>@Item.Title <LowStockBadge Available="Item.Available" Threshold="LowStockThreshold" /></td>
<td class="text-end">@Item.OnHand</td>
<td class="text-end">@Item.Reserved</td>
<td class="text-end">@Item.Available</td>
<td>
    <input type="number" min="1" max="500" class="form-control form-control-sm d-inline w-auto" @bind="amount" />
    <button class="btn btn-sm btn-primary" disabled="@saving" @onclick="RestockClicked">
        @(saving ? "Saving..." : "Restock")
    </button>
</td>

@code {
    private int amount = 10;
    private bool saving;
    private RowState? rendered;

    [Parameter, EditorRequired]
    public StockView Item { get; set; } = null!;

    [Parameter]
    public int LowStockThreshold { get; set; }

    [Parameter]
    public EventCallback<RestockRequest> OnRestock { get; set; }

    // Everything the markup depends on. StockView is a record, so equal data compares equal.
    private RowState Current => new(Item, Item.Available <= LowStockThreshold, saving);

    // Skip the render when nothing visible changed, e.g. a threshold change that doesn't move this row's badge.
    protected override bool ShouldRender() => Current != rendered;

    protected override void OnAfterRender(bool firstRender) => rendered = Current;

    private async Task RestockClicked()
    {
        saving = true;
        await OnRestock.InvokeAsync(new RestockRequest(Item.Isbn, amount));
        saving = false;
    }

    private sealed record RowState(StockView Item, bool IsLow, bool Saving);
}
