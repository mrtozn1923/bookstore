@typeparam TItem

<table class="table table-sm align-middle data-table">
    <thead>
        <tr>@HeaderTemplate</tr>
    </thead>
    <tbody>
        @if (Items.Count == 0)
        {
            <tr><td colspan="100" class="text-muted">@(EmptyTemplate ?? DefaultEmpty)</td></tr>
        }
        @foreach (TItem item in Items)
        {
            // The key keeps each row's DOM and component state with its item when the list is reordered.
            <tr @key="ItemKey(item)">@RowTemplate(item)</tr>
        }
    </tbody>
</table>

@code {
    private static readonly RenderFragment DefaultEmpty = builder => builder.AddContent(0, "Nothing to show.");

    [Parameter, EditorRequired]
    public IReadOnlyList<TItem> Items { get; set; } = [];

    [Parameter, EditorRequired]
    public Func<TItem, object> ItemKey { get; set; } = null!;

    [Parameter, EditorRequired]
    public RenderFragment HeaderTemplate { get; set; } = null!;

    [Parameter, EditorRequired]
    public RenderFragment<TItem> RowTemplate { get; set; } = null!;

    [Parameter]
    public RenderFragment? EmptyTemplate { get; set; }
}
