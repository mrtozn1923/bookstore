@implements IDisposable
@inject QuoteState Quote

<table class="table table-sm">
    <tbody>
        @foreach (QuoteLine line in Quote.Lines)
        {
            <tr @key="line.Isbn">
                <td>@line.Quantity x @line.Title</td>
                <td class="text-end"><Money Amount="line.Total" /></td>
                <td><button class="btn btn-sm btn-link" @onclick="() => Quote.Remove(line.Isbn)">Remove</button></td>
            </tr>
        }
    </tbody>
</table>
<p>
    @Quote.TotalQuantity items, subtotal <Money Amount="Quote.Subtotal" />,
    discount <Money Amount="Quote.Discount" />, total <strong><Money Amount="Quote.Total" /></strong>
</p>

@code {
    // QuoteState changes outside this component (BookPicker adds lines), so listen for it.
    protected override void OnInitialized() => Quote.Changed += OnQuoteChanged;

    private void OnQuoteChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Quote.Changed -= OnQuoteChanged;
}
