{
  "realm": "bookstore",
  "enabled": true,
  "roles": {
    "realm": [
      { "name": "StoreStaff" }
    ]
  },
  "clients": [
    {
      "clientId": "bookstore-backoffice",
      "enabled": true,
      "publicClient": false,
      "secret": "${BOOKSTORE_BACKOFFICE_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocolMappers": [
        {
          "name": "catalog-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "bookstore-catalog",
            "access.token.claim": "true"
          }
        },
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-bookstore-backoffice",
      "enabled": true,
      "serviceAccountClientId": "bookstore-backoffice",
      "realmRoles": [ "StoreStaff" ]
    }
  ]
}
