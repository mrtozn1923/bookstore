{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0,
    "analysis": {
      "filter": {
        "tr_lowercase": { "type": "lowercase", "language": "turkish" },
        "tr_stop": { "type": "stop", "stopwords": "_turkish_" },
        "tr_keywords": { "type": "keyword_marker", "keywords": ["ince", "kasaba", "öğretmen"] },
        "tr_stemmer": { "type": "stemmer", "language": "turkish" },
        "bookstore_synonyms": { "type": "synonym_graph", "synonyms_set": "bookstore-synonyms", "updateable": true }
      },
      "analyzer": {
        "tr_text": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": ["apostrophe", "tr_lowercase", "tr_stop", "tr_keywords", "tr_stemmer"]
        },
        "tr_folded": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": ["apostrophe", "tr_lowercase", "asciifolding"]
        },
        "search_synonyms": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": ["lowercase", "bookstore_synonyms"]
        }
      }
    }
  },
  "mappings": {
    "dynamic": "strict",
    "properties": {
      "isbn": { "type": "keyword" },
      "title": {
        "type": "text",
        "fields": {
          "keyword": { "type": "keyword", "ignore_above": 256 },
          "tr": { "type": "text", "analyzer": "tr_text" },
          "en": { "type": "text", "analyzer": "english" },
          "folded": { "type": "text", "analyzer": "tr_folded" },
          "sort": { "type": "icu_collation_keyword", "language": "tr" }
        }
      },
      "authors": {
        "type": "nested",
        "properties": {
          "name": {
            "type": "text",
            "fields": {
              "keyword": { "type": "keyword", "ignore_above": 256 },
              "folded": { "type": "text", "analyzer": "tr_folded" }
            }
          },
          "role": { "type": "keyword" }
        }
      },
      "categories": { "type": "keyword" },
      "language": { "type": "keyword" },
      "price": { "type": "scaled_float", "scaling_factor": 100 },
      "currency": { "type": "keyword" },
      "stockQuantity": { "type": "integer" },
      "publishedOn": { "type": "date", "format": "yyyy-MM-dd" },
      "averageRating": { "type": "half_float" },
      "description": {
        "type": "text",
        "search_analyzer": "search_synonyms",
        "fields": {
          "tr": { "type": "text", "analyzer": "tr_text" },
          "en": { "type": "text", "analyzer": "english" },
          "folded": { "type": "text", "analyzer": "tr_folded" }
        }
      }
    }
  }
}
