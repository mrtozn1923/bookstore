<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Images built with `dotnet publish /t:PublishContainer` (post 14) -->
  <PropertyGroup Label="Containers">
    <!-- Ubuntu "chiseled" base: no shell, no package manager, a non-root user. "extra" keeps ICU and tzdata,
         which SqlClient and time zone conversions need. -->
    <ContainerFamily>noble-chiseled-extra</ContainerFamily>
    <!-- The OpenAPI documents are generated by `dotnet build` and committed (post 03). Publishing for another
         runtime would start the app built for that runtime to generate them again, which fails across architectures. -->
    <OpenApiGenerateDocumentsOnBuild Condition="'$(_IsPublishing)' == 'true'">false</OpenApiGenerateDocumentsOnBuild>
  </PropertyGroup>
</Project>
