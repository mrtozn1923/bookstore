{
  "id": "/",
  "name": "Bookstore",
  "short_name": "Bookstore",
  "description": "Browse the catalog, keep a reading list and follow your orders.",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "theme_color": "#1e3a5f",
  "background_color": "#ffffff",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "screenshots": [
    {
      "src": "screenshots/catalog-wide.png",
      "sizes": "1280x800",
      "type": "image/png",
      "form_factor": "wide",
      "label": "The Bookstore catalog"
    },
    {
      "src": "screenshots/catalog-narrow.png",
      "sizes": "540x960",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "The Bookstore catalog on a phone"
    }
  ],
  "shortcuts": [
    { "name": "My orders", "url": "/orders?source=shortcut", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Settings", "url": "/settings?source=shortcut" }
  ]
}
