  <ItemGroup>
    <ProjectReference Include="..\..\src\Bookstore.Worker\Bookstore.Worker.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- the same Functions library the deploy loads -->
    <None Include="..\..\lab\functions\bookstore.lua" Link="bookstore.lua" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
