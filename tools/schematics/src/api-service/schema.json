{
  "$schema": "http://json-schema.org/schema",
  "$id": "BookstoreApiService",
  "title": "Bookstore API service",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Resource name, for example book.",
      "$default": { "$source": "argv", "index": 0 }
    },
    "path": {
      "type": "string",
      "description": "Folder for the generated files.",
      "default": "src/app"
    }
  },
  "required": ["name"]
}
