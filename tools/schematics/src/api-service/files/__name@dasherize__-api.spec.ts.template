import { provideHttpClient } from '@angular/common/http';
import { HttpTestingController, provideHttpClientTesting } from '@angular/common/http/testing';
import { TestBed } from '@angular/core/testing';
import { <%= classify(name) %>Api } from './<%= dasherize(name) %>-api';

describe('<%= classify(name) %>Api', () => {
  it('calls GET /api/<%= dasherize(name) %>s', () => {
    TestBed.configureTestingModule({
      providers: [provideHttpClient(), provideHttpClientTesting()],
    });
    const api = TestBed.inject(<%= classify(name) %>Api);
    const http = TestBed.inject(HttpTestingController);

    api.getAll().subscribe();

    http.expectOne('/api/<%= dasherize(name) %>s').flush([]);
    http.verify();
  });
});
