<?xml version="1.0" encoding="utf-8"?>
<!-- CI restores and pushes through the Bookstore feed only. nuget.org reaches the build as an upstream source of the feed. -->
<configuration>
  <packageSources>
    <clear />
    <add key="bookstore" value="https://pkgs.dev.azure.com/bookstore-org/Bookstore/_packaging/bookstore/nuget/v3/index.json" />
  </packageSources>
</configuration>
