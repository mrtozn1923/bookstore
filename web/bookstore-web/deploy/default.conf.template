server {
    listen 8080;
    root /usr/share/nginx/html;

    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }

    location /api/ {
        resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
        set $upstream ${API_UPSTREAM};
        proxy_pass $upstream;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
