{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(dotnet build *)",
      "Bash(dotnet test *)",
      "Bash(npm test *)",
      "Bash(npm run build *)",
      "PowerShell(dotnet build *)",
      "PowerShell(dotnet test *)",
      "PowerShell(npm test *)",
      "PowerShell(npm run build *)",
      "mcp__plugin_bookstore-dev_bookstore__search_books",
      "mcp__plugin_bookstore-dev_bookstore__check_stock",
      "mcp__plugin_bookstore-dev_bookstore-db__search_objects"
    ],
    "ask": [
      "Bash(dotnet ef database update *)",
      "Bash(git push *)",
      "PowerShell(dotnet ef database update *)",
      "PowerShell(git push *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/appsettings.Production.json)",
      "Read(~/AppData/Roaming/Microsoft/UserSecrets/**)",
      "Read(~/.microsoft/usersecrets/**)",
      "Bash(dotnet user-secrets *)",
      "PowerShell(dotnet user-secrets *)",
      "mcp__plugin_bookstore-dev_playwright__browser_run_code_unsafe",
      "mcp__plugin_bookstore-dev_playwright__browser_file_upload"
    ]
  },
  "extraKnownMarketplaces": {
    "bookstore": {
      "source": {
        "source": "directory",
        "path": "./"
      }
    }
  },
  "enabledPlugins": {
    "bookstore-dev@bookstore": true
  }
}
